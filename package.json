{
  "name": "fogo-dsin-coder-challenge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "F.O.G.O. - sistema web de monitoramento de equipamentos urbanos (DSIN Coder Challenge 2026)",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "node scripts/checar-node.mjs && node scripts/checar-porta.mjs && concurrently -n servidor,web -c yellow,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node scripts/checar-node.mjs && node scripts/checar-porta.mjs && npm run build && tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "e2e": "playwright test",
    "empacotar": "node scripts/empacotar.mjs",
    "token": "tsx scripts/token.ts",
    "senha": "tsx scripts/senha.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "better-sqlite3": "^13.0.3",
    "d3-delaunay": "^6.0.4",
    "fastify": "^5.12.7",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "1.64.1",
    "@tanstack/react-query": "^5.104.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-delaunay": "^6.0.4",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
